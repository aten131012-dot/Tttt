local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local function visualBall(pos,color,startSize,endSize,duration)
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Ball
    p.Material = Enum.Material.Neon
    p.Color = color
    p.Size = Vector3.one*startSize
    p.CFrame = CFrame.new(pos)
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Parent = workspace

    TS:Create(p,TweenInfo.new(duration,Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out),{
        Size = Vector3.one*endSize,
        Transparency = 1
    }):Play()
    Debris:AddItem(p,duration+0.15)
end

local function burst(pos)
    visualBall(pos,Color3.fromRGB(255,170,70),2,18,0.35)
    visualBall(pos,Color3.fromRGB(190,80,255),3,32,0.6)
    visualBall(pos,Color3.fromRGB(70,220,255),1,12,0.3)
end

local function shockwave(pos)
    visualBall(pos,Color3.fromRGB(75,255,220),4,100,0.7)
    visualBall(pos,Color3.fromRGB(180,80,255),2,65,0.9)

    local ring = Instance.new("Part")
    ring.Name = "NEXORA_SonicRing"
    ring.Shape = Enum.PartType.Cylinder
    ring.Size = Vector3.new(0.5,5,5)
    ring.CFrame = CFrame.new(pos)*CFrame.Angles(0,0,math.rad(90))
    ring.Material = Enum.Material.Neon
    ring.Color = Color3.fromRGB(70,220,255)
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanTouch = false
    ring.CanQuery = false
    ring.Parent = workspace

    TS:Create(ring,TweenInfo.new(0.8,Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out),{
        Size = Vector3.new(0.5,120,120),
        Transparency = 1
    }):Play()
    Debris:AddItem(ring,1)
    burst(pos)
end

local function missile()
    if not (J.riding and J.jet and J.jet.PrimaryPart) then return end

    local jetCF = J.jet.PrimaryPart.CFrame
    local startCF = jetCF*CFrame.new(math.random(-4,4),-0.8,-2)

    local p = Instance.new("Part")
    p.Name = "NEXORA_MissileFX"
    p.Size = Vector3.new(0.45,0.45,2)
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(70,220,255)
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CFrame = startCF
    p.Parent = workspace

    local a0 = Instance.new("Attachment",p)
    a0.Position = Vector3.new(0,0,0.8)
    local a1 = Instance.new("Attachment",p)
    a1.Position = Vector3.new(0,0,-0.8)

    local tr = Instance.new("Trail")
    tr.Attachment0 = a0
    tr.Attachment1 = a1
    tr.Lifetime = 0.35
    tr.Color = ColorSequence.new(
        Color3.fromRGB(255,220,130),
        Color3.fromRGB(255,65,30))
    tr.Parent = p

    local start = os.clock()
    local conn
    conn = RS.Heartbeat:Connect(function(dt)
        if not p.Parent or not J.riding then
            conn:Disconnect()
            p:Destroy()
            return
        end

        local age = os.clock()-start
        p.CFrame = p.CFrame+ p.CFrame.LookVector*(100*dt)

        if age > 2 then
            local at = p.Position
            conn:Disconnect()
            p:Destroy()
            burst(at)
        end
    end)
    Debris:AddItem(p,3)
end

local cooldowns = {}
local function activate(name,cd,fn)
    if not J.riding then return end
    local now = os.clock()
    if cooldowns[name] and now < cooldowns[name] then return end
    cooldowns[name] = now+cd
    fn()
end

