-- NEXORA | JET V3 — PART 3/5
local ENV = (getgenv and getgenv()) or _G
local J = ENV.NEXORA_JET
if not (J and J.buildJet) then
    warn("กรุณารัน PART 1 และ PART 2 ก่อน")
    return
end

local Players = game:GetService("Players")
local RS = game:GetService("RunService")
local LP = Players.LocalPlayer
local Cam = workspace.CurrentCamera

local GROUND_SPEED = 35
local REVERSE_SPEED = 15
local AIR_SPEED = 90

local jet, flyConn
local hrp, hum
local pos = Vector3.zero
local yaw, pitch, roll, speed = 0,0,0,0
local wantTakeoff = false
local oldCameraType, oldSubject, oldFOV
local oldAnchor, oldPlatform

local function groundY(at)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {jet,LP.Character}
    params.IgnoreWater = true
    local hit = workspace:Raycast(
        at + Vector3.new(0,12,0),
        Vector3.new(0,-400,0),params)
    return hit and hit.Position.Y or nil
end

local function showCharacter()
    local c = LP.Character
    if not c then return end
    for _,d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            d.LocalTransparencyModifier = 0
        end
    end
end

local function hideCharacter()
    local c = LP.Character
    if not c then return end
    for _,d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            d.LocalTransparencyModifier = 1
        end
    end
end

function J.cleanup()
    J.riding = false
    J.boosting = false
    J.rolling = false
    J.mode = "ground"
    J.camLocked = true
    J.shieldUntil = 0
    J.cloakUntil = 0
    wantTakeoff = false

    for k in pairs(J.inp) do J.inp[k] = false end

    if flyConn then
        flyConn:Disconnect()
        flyConn = nil
    end

    if hrp and hrp.Parent then
        hrp.Anchored = oldAnchor or false
    end
    if hum and hum.Parent then
        hum.PlatformStand = oldPlatform or false
    end

    showCharacter()

    Cam.CameraType = oldCameraType or Enum.CameraType.Custom
    if oldSubject then Cam.CameraSubject = oldSubject end
    if oldFOV then Cam.FieldOfView = oldFOV end

    if jet then
        jet:Destroy()
        jet = nil
    end
    J.jet = nil
    J.setUI("idle")
end

J.callBtn.Activated:Connect(function()
    if jet then return end
    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if not root then return end

    J.setUI("none")
    jet = J.buildJet()
    J.jet = jet

    local forward = root.CFrame.LookVector
    local flat = Vector3.new(forward.X,0,forward.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0,0,-1) end
    flat = flat.Unit

    local target = root.Position + flat*28
    local gy = groundY(target) or root.Position.Y-3
    pos = Vector3.new(target.X,gy+J.GROUND_H,target.Z)
    yaw = math.atan2(-flat.X,-flat.Z)

    jet:PivotTo(CFrame.new(pos)*CFrame.Angles(0,yaw,0))
    J.setWheels(true)
    J.setFire(0,false)
    J.setUI("landed")
end)

J.boardBtn.Activated:Connect(function()
    if not jet or J.riding then return end
    local c = LP.Character
    hrp = c and c:FindFirstChild("HumanoidRootPart")
    hum = c and c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    oldAnchor = hrp.Anchored
    oldPlatform = hum.PlatformStand
    oldCameraType = Cam.CameraType
    oldSubject = Cam.CameraSubject
    oldFOV = Cam.FieldOfView

    J.riding = true
    J.mode = "ground"
    J.camLocked = true
    J.camYaw, J.camPitch, J.camDist = 0,0.12,34
    wantTakeoff = false

    hum.PlatformStand = true
    hrp.Anchored = true
    hideCharacter()

    Cam.CameraType = Enum.CameraType.Scriptable
    J.setWheels(true)
    J.setUI("riding")

    flyConn = RS.RenderStepped:Connect(function(dt)
        if not (J.riding and jet and jet.Parent
            and hrp and hrp.Parent and hum and hum.Parent) then
            J.cleanup()
            return
        end

        local turn = (J.inp.left and 1 or 0)
            - (J.inp.right and 1 or 0)
        local climb = (J.inp.up and 1 or 0)
            - (J.inp.down and 1 or 0)

        if wantTakeoff and J.mode == "ground" then
            J.mode = "air"
            pitch = math.max(pitch,0.28)
            speed = math.max(speed,35)
            J.setWheels(false)
            J.takeoffBtn.Visible = false
        end
        wantTakeoff = false

        if J.mode == "ground" then
            local throttle = climb
            local maxSpeed = GROUND_SPEED * (J.boosting and 1.8 or 1)
            local targetSpeed = throttle >= 0
                and throttle*maxSpeed or throttle*REVERSE_SPEED
            speed = speed + (targetSpeed-speed)*math.clamp(dt*1.8,0,1)

            yaw = yaw + turn*1.5*dt*(speed < 0 and -1 or 1)
            pitch = pitch + (0-pitch)*math.clamp(dt*5,0,1)
            roll = roll + (0-roll)*math.clamp(dt*5,0,1)

            local forward = Vector3.new(-math.sin(yaw),0,-math.cos(yaw))
            pos = pos + forward*speed*dt

            local gy = groundY(pos)
            if gy then
                local targetY = gy+J.GROUND_H
                pos = Vector3.new(pos.X,
                    pos.Y+(targetY-pos.Y)*math.clamp(dt*8,0,1),pos.Z)
            end
            J.setFire(math.abs(speed)*0.5+(J.boosting and 150 or 5),J.boosting)
        else
            local airTarget = AIR_SPEED*(J.boosting and 2 or 1)
            speed = speed+(airTarget-speed)*math.clamp(dt*0.7,0,1)
            yaw = yaw+turn*1.3*dt
            pitch = math.clamp(pitch+climb*0.9*dt,-1.0,1.0)
            roll = roll+(turn*0.8-roll)*math.clamp(dt*4,0,1)
            J.setFire(J.boosting and 260 or 85,J.boosting)
        end

        local rot = CFrame.Angles(0,yaw,0)
            * CFrame.Angles(pitch,0,0)
            * CFrame.Angles(0,0,roll)

        if J.mode == "air" then
            pos = pos+rot.LookVector*speed*dt
            local gy = groundY(pos)
            if gy and pos.Y <= gy+J.GROUND_H and rot.LookVector.Y < 0 then
                pos = Vector3.new(pos.X,gy+J.GROUND_H,pos.Z)
                J.mode = "ground"
                J.setWheels(true)
                J.takeoffBtn.Visible = true
                J.setFire(10,false)
            end
        end

        local cf = CFrame.new(pos)*rot
        jet:PivotTo(cf)
        hrp.CFrame = cf*CFrame.new(0,1,-4)
        hrp.AssemblyLinearVelocity = Vector3.zero

        -- ล็อกกล้อง = อยู่ด้านหลังเจ็ตตลอด
        -- ปลดล็อก = ใช้มุมกล้องที่ผู้เล่นลากปรับเอง
        if J.camLocked then
            J.camYaw = J.camYaw+(0-J.camYaw)*math.clamp(dt*5,0,1)
            J.camPitch = J.camPitch+(0.12-J.camPitch)*math.clamp(dt*5,0,1)
        end

        local orbit = CFrame.Angles(0,J.camYaw,0)
            * CFrame.Angles(-J.camPitch,0,0)
        local camPos = (CFrame.new(pos)*rot*orbit
            * CFrame.new(0,4,J.camDist)).Position
        local lookAt = pos+Vector3.new(0,2,0)
            +rot.LookVector*10
        local desired = CFrame.lookAt(camPos,lookAt)
        Cam.CFrame = Cam.CFrame:Lerp(desired,math.clamp(dt*10,0,1))
        Cam.Focus = CFrame.new(pos)

        local fov = 70+(J.boosting and 14 or 0)
        Cam.FieldOfView = Cam.FieldOfView
            +(fov-Cam.FieldOfView)*math.clamp(dt*4,0,1)
    end)
end)

