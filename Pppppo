local lastDrag = 0

-- แตะเพื่อสลับล็อก/ปลดล็อกกล้อง
J.cameraBtn.Activated:Connect(function()
    if not J.riding then return end

    J.camLocked = not J.camLocked
    if J.camLocked then
        J.cameraBtn.Text = "🔒 กล้องล็อก"
        J.camYaw = 0
        J.camPitch = 0.12
    else
        J.cameraBtn.Text = "🔓 หมุนกล้อง"
    end
end)

-- ลากหมุนกล้องตอนปลดล็อก
UIS.InputBegan:Connect(function(input, processed)
    if processed or not J.riding or J.camLocked then return end

    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton2 then
        dragInput = input
        lastDrag = os.clock()
    elseif t == Enum.UserInputType.Touch then
        local camera = workspace.CurrentCamera
        local p = input.Position
        -- กันไม่ให้การแตะปุ่มควบคุมด้านข้างไปหมุนกล้อง
        if p.X > camera.ViewportSize.X*0.25
        and p.X < camera.ViewportSize.X*0.78
        and p.Y > camera.ViewportSize.Y*0.15 then
            dragInput = input
            lastDrag = os.clock()
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if not J.riding or J.camLocked or not dragInput then return end

    if input.UserInputType == Enum.UserInputType.MouseWheel then
        J.camDist = math.clamp(
            J.camDist-input.Position.Z*3,16,75)
        return
    end

    local isTouch = dragInput.UserInputType == Enum.UserInputType.Touch
    if (isTouch and input == dragInput)
    or (not isTouch and input.UserInputType == Enum.UserInputType.MouseMovement) then
        J.camYaw = J.camYaw-input.Delta.X*0.006
        J.camPitch = math.clamp(
            J.camPitch-input.Delta.Y*0.005,-0.45,1.1)
        lastDrag = os.clock()
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == dragInput then
        dragInput = nil
        lastDrag = os.clock()
    end
end)

-- ซูมด้วยการจีบนิ้วบนอุปกรณ์ที่รองรับ
local pinchStart = J.camDist
pcall(function()
    UIS.TouchPinch:Connect(function(_,scale,_,state,processed)
        if processed or not J.riding or J.camLocked then return end

        if state == Enum.UserInputState.Begin then
            pinchStart = J.camDist
        end

        J.camDist = math.clamp(
            pinchStart/math.max(scale,0.1),16,75)
    end)
end)

