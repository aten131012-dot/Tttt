-- NEXORA | JET V3 — PART 2/5
local ENV = (getgenv and getgenv()) or _G
local J = ENV.NEXORA_JET
if not J then warn("กรุณารัน PART 1 ก่อน") return end

local V = Vector3.new
local N = CFrame.new
local A = CFrame.Angles

local DARK = Color3.fromRGB(35,40,52)
local GREY = Color3.fromRGB(105,118,135)
local BLACK = Color3.fromRGB(12,17,26)
local RED = Color3.fromRGB(240,40,60)
local CYAN = Color3.fromRGB(65,210,255)
local PURPLE = Color3.fromRGB(180,90,255)

local function makePart(m,size,cf,color,mat,transparency,shape)
    local p = Instance.new("Part")
    p.Size = size
    p.CFrame = cf
    p.Color = color
    p.Material = mat or Enum.Material.Metal
    p.Transparency = transparency or 0
    p.Shape = shape or Enum.PartType.Block
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.CastShadow = false
    p.Parent = m
    return p
end

local function sphereMesh(p,scale)
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = scale
    mesh.Parent = p
    return mesh
end

function J.buildJet()
    local m = Instance.new("Model")
    m.Name = "NEXORA_Jet_V3"

    local pivot = makePart(m,V(1,1,1),N(0,0,0),DARK,nil,1)
    m.PrimaryPart = pivot

    -- ลำตัวหลัก: หัวเครื่องอยู่ทาง -Z
    makePart(m,V(2.8,1.8,13),N(0,0,0.5),DARK)
    makePart(m,V(2.3,0.65,10),N(0,0.95,0),GREY)
    makePart(m,V(2.2,0.6,8),N(0,-0.9,0),GREY)

    -- หัวเจ็ตเรียวแหลม
    local nose = makePart(m,V(1.8,1.15,5.4),
        N(0,0.15,-7.4),GREY)
    sphereMesh(nose,V(0.8,0.65,2.3))

    makePart(m,V(0.12,0.12,2.3),
        N(0,0.05,-11.0),CYAN,Enum.Material.Neon)

    -- ขอบกระจกห้องนักบิน
    local canopyFrame = makePart(m,V(2.05,0.22,5.0),
        N(0,1.15,-4.5),BLACK)
    sphereMesh(canopyFrame,V(1.0,0.85,2.3))

    -- กระจกทรงหยดน้ำยาวรี ไม่ใช่ลูกบอลกลม
    local glass = makePart(m,V(1.85,0.2,4.65),
        N(0,1.28,-4.55),Color3.fromRGB(60,165,220),
        Enum.Material.Glass,0.22)
    sphereMesh(glass,V(0.96,0.82,2.25))

    -- แถบสะท้อนแสงบนกระจก
    makePart(m,V(0.08,0.035,3.2),
        N(-0.45,1.45,-4.6),Color3.fromRGB(190,240,255),
        Enum.Material.Neon,0.25)

    -- ปีกหลัก ปีกท้าย และครีบหาง
    for _,s in ipairs({-1,1}) do
        local wing = makePart(m,V(9.5,0.3,4.8),
            N(5.0*s,-0.25,1.2)*A(0,math.rad(-18*s),0),GREY)
        wing.Name = s == 1 and "WingR" or "WingL"

        makePart(m,V(3.4,0.25,2.6),
            N(2.4*s,-0.2,6.6)*A(0,math.rad(-25*s),0),DARK)

        makePart(m,V(0.3,2.8,2.8),
            N(1.8*s,1.2,6.3)*A(0,0,math.rad(-12*s)),DARK)

        makePart(m,V(0.15,0.15,7.0),
            N(1.4*s,0.15,-0.1),RED,Enum.Material.Neon)

        local tip = makePart(m,V(0.35,0.35,2.4),
            N(9.1*s,-0.1,3.0),CYAN,Enum.Material.Neon)
        tip.Name = s == 1 and "TipR" or "TipL"

        local at0 = Instance.new("Attachment",tip)
        at0.Position = V(0,0,-1.1)
        local at1 = Instance.new("Attachment",tip)
        at1.Position = V(0,0,1.1)

        local trail = Instance.new("Trail")
        trail.Attachment0 = at0
        trail.Attachment1 = at1
        trail.Lifetime = 0.6
        trail.Color = ColorSequence.new(CYAN,PURPLE)
        trail.Transparency = NumberSequence.new(0.1,1)
        trail.Enabled = false
        trail.Parent = tip
    end

    -- เครื่องยนต์คู่และไฟท้าย
    local exhausts = Instance.new("Folder")
    exhausts.Name = "Exhausts"
    exhausts.Parent = m

    for _,s in ipairs({-1,1}) do
        makePart(m,V(1.35,1.35,3.2),N(0.9*s,0,7.3),
            BLACK,Enum.Material.Metal,0,Enum.PartType.Cylinder)

        makePart(m,V(1.5,1.5,0.25),N(0.9*s,0,8.9),
            RED,Enum.Material.Neon,0,Enum.PartType.Cylinder)

        local ex = makePart(m,V(0.4,0.4,0.4),
            N(0.9*s,0,9.5),DARK,nil,1)
        ex.Name = "Ex"..s
        ex.Parent = exhausts

        local att = Instance.new("Attachment",ex)
        att.Position = V(0,0,0)

        local fire = Instance.new("ParticleEmitter")
        fire.Name = "FireFx"
        fire.Texture = "rbxasset://textures/particles/fire_main.dds"
        fire.Color = ColorSequence.new(
            Color3.fromRGB(255,245,170),
            Color3.fromRGB(255,70,30))
        fire.Lifetime = NumberRange.new(0.25,0.5)
        fire.Speed = NumberRange.new(15,30)
        fire.Rate = 0
        fire.SpreadAngle = V(5,5)
        fire.LightEmission = 1
        fire.Parent = att

        local smoke = Instance.new("ParticleEmitter")
        smoke.Name = "SmokeFx"
        smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
        smoke.Lifetime = NumberRange.new(0.5,1)
        smoke.Speed = NumberRange.new(5,12)
        smoke.Rate = 0
        smoke.Parent = att

        local light = Instance.new("PointLight")
        light.Color = Color3.fromRGB(255,120,40)
        light.Range = 14
        light.Brightness = 0
        light.Parent = ex
    end

    -- ล้อเครื่องบิน
    local wheels = Instance.new("Folder")
    wheels.Name = "Wheels"
    wheels.Parent = m
    for _,data in ipairs({
        {1.6,-1.4,2.5},{-1.6,-1.4,2.5},{0,-1.4,-6}
    }) do
        local w = makePart(m,V(0.55,0.9,0.9),
            N(data[1],data[2],data[3]),BLACK,
            Enum.Material.Rubber,0,Enum.PartType.Cylinder)
        w.Parent = wheels
    end

    local shield = makePart(m,V(1,1,1),N(0,0,0),
        CYAN,Enum.Material.ForceField,1,Enum.PartType.Ball)
    shield.Name = "Shield"
    sphereMesh(shield,V(18,18,24))

    local hl = Instance.new("Highlight")
    hl.Name = "BoostHL"
    hl.Adornee = m
    hl.FillColor = PURPLE
    hl.OutlineColor = CYAN
    hl.FillTransparency = 0.82
    hl.Enabled = false
    hl.Parent = m

    m.Parent = workspace
    return m
end

function J.setFire(rate,boost)
    if not J.jet then return end
    local folder = J.jet:FindFirstChild("Exhausts")
    if not folder then return end

    local hl = J.jet:FindFirstChild("BoostHL")
    if hl then hl.Enabled = boost end

    for _,ex in ipairs(folder:GetChildren()) do
        local att = ex:FindFirstChildOfClass("Attachment")
        local light = ex:FindFirstChildOfClass("PointLight")
        if att then
            local f = att:FindFirstChild("FireFx")
            local s = att:FindFirstChild("SmokeFx")
            if f then
                f.Rate = rate
                f.Speed = boost and NumberRange.new(35,55)
                    or NumberRange.new(15,30)
                f.Color = boost
                    and ColorSequence.new(CYAN,PURPLE)
                    or ColorSequence.new(Color3.fromRGB(255,230,150),
                        Color3.fromRGB(255,60,20))
            end
            if s then s.Rate = boost and 0 or rate*0.12 end
        end
        if light then
            light.Brightness = rate > 0 and (boost and 5 or 2) or 0
            light.Color = boost and PURPLE or Color3.fromRGB(255,130,40)
        end
    end
end

function J.setWheels(on)
    if not J.jet then return end
    local f = J.jet:FindFirstChild("Wheels")
    if f then
        for _,p in ipairs(f:GetChildren()) do
            p.Transparency = on and 0 or 1
        end
    end
end

