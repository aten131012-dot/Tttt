local function buildJet()
	local m = Instance.new("Model")
	m.Name = "NEXORA_Jet"
	local V, A, N = Vector3.new, CFrame.Angles, CFrame.new
	local DARK = Color3.fromRGB(45, 50, 62)
	local GREY = Color3.fromRGB(110, 120, 135)
	local LIGHT = Color3.fromRGB(190, 195, 205)
	local BLACK = Color3.fromRGB(15, 16, 20)

	local function mk(size, cf, color, opts)
		opts = opts or {}
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = opts.mat or Enum.Material.Metal
		p.Transparency = opts.tr or 0
		if opts.refl then p.Reflectance = opts.refl end
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		if opts.shape then p.Shape = opts.shape end
		if opts.mesh then
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = opts.mesh
			sm.Scale = Vector3.new(1, 1, 1)
			sm.Parent = p
		end
		if opts.accent then p:SetAttribute("Accent", true) end
		p.CFrame = cf
		p.Parent = m
		return p
	end

	local function cyl(len, dia, cf, color, opts)
		opts = opts or {}
		opts.shape = Enum.PartType.Cylinder
		return mk(V(len, dia, dia), cf * A(0, math.rad(90), 0), color, opts)
	end

	-- แท่งเชื่อมจุดสองจุด (ใช้ทำโครงหลังคา)
	local function bar(p1, p2, th, color)
		local d = p2 - p1
		local len = d.Magnitude
		if len < 0.001 then return end
		mk(V(th, th, len + 0.02), CFrame.lookAt(p1 + d / 2, p2), color)
	end

	local pivot = mk(V(1, 1, 1), N(0, 0, 0), DARK, {tr = 1})

	-- ลำตัว
	mk(V(2.8, 2.0, 12), N(0, 0, 0.5), DARK)
	mk(V(2.0, 0.7, 11), N(0, 1.15, 1.5), GREY)
	mk(V(2.4, 0.5, 9), N(0, -1.05, 1.5), GREY)
	mk(V(2.3, 1.7, 3), N(0, 0, -7), GREY)
	mk(V(1.7, 1.3, 3), N(0, -0.05, -9.6), DARK)
	mk(V(1.2, 1.0, 5), N(0, -0.1, -13.2), GREY, {mesh = Enum.MeshType.Sphere})
	mk(V(0.12, 0.12, 2.6), N(0, -0.1, -16.6), LIGHT)
	mk(V(0.12, 0.45, 9), N(1.43, 0, -0.5), RED, {mat = Enum.Material.Neon, accent = true})
	mk(V(0.12, 0.45, 9), N(-1.43, 0, -0.5), RED, {mat = Enum.Material.Neon, accent = true})

	-- ===== ห้องนักบิน (หลังคาทรงหยดน้ำแบบเจ็ตขับไล่) =====
	-- ศูนย์กลางกระจก z=-5.6 ครึ่งความยาว 2.6 ฐาน y=1.05
	local ZC, HL, BASE_Y, RX, RY = -5.6, 2.6, 1.05, 0.75, 0.9

	-- บอลเลย์/ขอบรอบห้องนักบิน
	mk(V(1.7, 0.18, 6.4), N(0, 1.02, -5.3), BLACK)

	-- แฟริ่งท้ายหลังคาต่อเข้ากับสันหลัง
	mk(V(1.3, 1.1, 5.2), N(0, 1.2, -2.1), GREY, {mesh = Enum.MeshType.Sphere})

	-- ภายในห้องนักบิน: เบาะ นักบิน แผงหน้าปัด HUD
	mk(V(0.8, 0.45, 0.9), N(0, 1.2, -4.7), BLACK)
	mk(V(0.8, 0.8, 0.2), N(0, 1.35, -4.2), BLACK)
