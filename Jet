end)

-- ===== ยิงมิสไซล์ (สลับซ้าย/ขวาใต้ปีก) =====
local podIdx = 1
local pods = {Vector3.new(4.5, -0.95, 1.1), Vector3.new(-4.5, -0.95, 1.1)}

local function fireMissile()
	local jet = S.jet
	if not (S.riding and jet and jet.PrimaryPart) then return end
	podIdx = 3 - podIdx

	local launchCF = jet.PrimaryPart.CFrame * CFrame.new(pods[podIdx])
	J.muzzleFlash(launchCF.Position)
	local mm = J.newMissile(launchCF)
	local life = 0
	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not mm.Parent then conn:Disconnect() return end
		life = life + dt
		local spd = math.min(320, 140 + life * 500)
		local cf0 = mm.PrimaryPart.CFrame
		local stepLen = spd * dt

		local ex = {mf}
		if S.jet then table.insert(ex, S.jet) end
		if lp.Character then table.insert(ex, lp.Character) end
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = ex
		rp.IgnoreWater = true

		local hit = workspace:Raycast(cf0.Position, cf0.LookVector * (stepLen + 2), rp)
		if hit then
			conn:Disconnect()
			J.explode(hit.Position)
			mm:Destroy()
			return
		end
		mm:PivotTo(cf0 + cf0.LookVector * stepLen)
		if life >= 3 then
			conn:Disconnect()
			J.explode(cf0.Position)
			mm:Destroy()
		end
	end)
end

-- ===== ระบบสกิล =====
local function reg(btn, label, cd, fn)
	local d = {btn = btn, label = label, cd = cd, activeUntil = 0, cdUntil = 0}
	table.insert(skillDefs, d)
	btn.MouseButton1Click:Connect(function()
		if not S.riding then return end
		local n = os.clock()
		if n < d.cdUntil then return end
		d.cdUntil = n + cd
		if fn(d, n) == false then d.cdUntil = 0 end
	end)
end

local function hasJet()
	return S.jet and S.jet.PrimaryPart
end

