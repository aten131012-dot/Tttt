-- ===== ซ่อน/คืนตัวละคร =====
local hidden, charHidden, oldDisplay = {}, false, nil
local function hideChar(c)
	hidden = {}
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			hidden[d] = d.Transparency
			d.Transparency = 1
		end
	end
	local hum = c:FindFirstChildOfClass("Humanoid")
	if hum then
		oldDisplay = hum.DisplayDistanceType
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	charHidden = true
end
local function showChar()
	if not charHidden then return end
	charHidden = false
	for d, tr in pairs(hidden) do
		if d.Parent then pcall(function() d.Transparency = tr end) end
	end
	hidden = {}
	local c = lp.Character
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if hum and oldDisplay then pcall(function() hum.DisplayDistanceType = oldDisplay end) end
end

-- หาความสูงพื้นใต้ตำแหน่ง
local function groundY(pos)
	local list = {mf}
	if S.jet then table.insert(list, S.jet) end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then table.insert(list, p.Character) end
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = list
	rp.IgnoreWater = true
	local r = workspace:Raycast(pos + Vector3.new(0, 12, 0), Vector3.new(0, -300, 0), rp)
	return r and r.Position.Y or nil
end

local function cleanup()
	S.riding, S.boosting, S.wantTakeoff = false, false, false
	S.rolling, S.cloakOn, S.rainbowOn = false, false, false
	S.shieldUntil, S.cloakUntil, S.rainbowUntil, S.laserUntil = 0, 0, 0, 0
	S.shake, S.speed, S.mode = 0, 0, "ground"
	for _, h in ipairs(J.cleanupHooks) do pcall(h) end
	for k in pairs(inp) do inp[k] = false end
	if flyConn then flyConn:Disconnect() flyConn = nil end
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
