track(RS.RenderStepped:Connect(function()
	local t = os.clock()
	for _, d in ipairs(skillDefs) do
		local txt, tr = d.label, 0
		if t < d.activeUntil then
			txt = d.label .. " ●"
		elseif t < d.cdUntil then
			tr = 0.55
			if d.cd >= 3 then txt = d.label .. " " .. math.ceil(d.cdUntil - t) end
		end
		if d.btn.Text ~= txt then d.btn.Text = txt end
		if d.btn.TextTransparency ~= tr then d.btn.TextTransparency = tr end
	end
end))

