	sp.CanCollide = false
	sp.CanQuery = false
	sp.CanTouch = false
	sp.Transparency = 1
	sp.Size = Vector3.new(1, 1, 1)
	sp.CFrame = CFrame.new(pos)
	sp.Parent = workspace

	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SPARK_TEX
	pe.Color = ColorSequence.new(Color3.fromRGB(255, 230, 150), Color3.fromRGB(255, 90, 30))
	pe.Size = NumberSequence.new({NSK(0, 1.2), NSK(1, 0)})
	pe.Lifetime = NumberRange.new(0.5, 0.9)
	pe.Speed = NumberRange.new(30 * sc, 60 * sc)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -20, 0)
	pe.LightEmission = 1
	pe.Rate = 0
	pe.Parent = sp
	pe:Emit(math.max(8, math.floor(45 * sc)))

	local sm = Instance.new("ParticleEmitter")
	sm.Texture = SMOKE_TEX
	sm.Color = ColorSequence.new(Color3.fromRGB(70, 70, 76))
	sm.Size = NumberSequence.new({NSK(0, 2 * sc), NSK(1, 7 * sc)})
	sm.Transparency = NumberSequence.new({NSK(0, 0.4), NSK(1, 1)})
	sm.Lifetime = NumberRange.new(1, 1.8)
	sm.Speed = NumberRange.new(6, 14)
	sm.SpreadAngle = Vector2.new(180, 180)
	sm.Rate = 0
	sm.Parent = sp
	sm:Emit(math.max(4, math.floor(12 * sc)))
	Debris:AddItem(sp, 2.2)

	-- สั่นกล้องตามระยะ
	local c = workspace.CurrentCamera
	if c then
		local d = (c.CFrame.Position - pos).Magnitude
		if d < 130 then addShake(sc * 0.5 * (1 - d / 130)) end
	end
