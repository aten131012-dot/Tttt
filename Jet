local function dropBomb(cf, vel)
	local m = Instance.new("Model")
	m.Name = "Bomb"
	local function part(size, off, color, mat, shape, rot)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = mat or Enum.Material.Metal
		if shape then p.Shape = shape end
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CFrame = cf * CFrame.new(off) * (rot or CFrame.new())
		p.Parent = m
		return p
	end
	local pivot = part(Vector3.new(0.2, 0.2, 0.2), Vector3.new(0, 0, 0), Color3.new(0, 0, 0))
	pivot.Transparency = 1
	m.PrimaryPart = pivot
	local rotY = CFrame.Angles(0, math.rad(90), 0)
	part(Vector3.new(3.4, 1.1, 1.1), Vector3.new(0, 0, 0), Color3.fromRGB(55, 62, 55), Enum.Material.Metal, Enum.PartType.Cylinder, rotY)
	part(Vector3.new(0.35, 1.18, 1.18), Vector3.new(0, 0, -0.6), Color3.fromRGB(255, 120, 40), Enum.Material.Neon, Enum.PartType.Cylinder, rotY)
	part(Vector3.new(0.9, 0.9, 0.9), Vector3.new(0, 0, -1.8), Color3.fromRGB(255, 170, 60), Enum.Material.Neon, Enum.PartType.Ball)
	part(Vector3.new(1.9, 0.1, 0.8), Vector3.new(0, 0, 1.4), Color3.fromRGB(35, 40, 48))
	part(Vector3.new(0.1, 1.9, 0.8), Vector3.new(0, 0, 1.4), Color3.fromRGB(35, 40, 48))

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.4, 1.6)
	a0.Parent = pivot
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.4, 1.6)
	a1.Parent = pivot
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.6
	tr.LightEmission = 1
	tr.LightInfluence = 0
	tr.Color = ColorSequence.new(Color3.fromRGB(255, 200, 100), Color3.fromRGB(255, 70, 20))
	tr.Transparency = NumberSequence.new({NSK(0, 0.1), NSK(1, 1)})
	tr.Parent = pivot
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 60)
	light.Range = 14
	light.Brightness = 2
	light.Parent = pivot
	m.Parent = mf

	local pos = cf.Position
	local v = vel + Vector3.new(0, -8, 0)
	local life = 0
	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not m.Parent then conn:Disconnect() return end
		life = life + dt
		v = v + Vector3.new(0, -75, 0) * dt
		local step = v * dt
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = excludeList()
		rp.IgnoreWater = true
		local hit = workspace:Raycast(pos, step + step.Unit * 1, rp)
		if hit then
			conn:Disconnect()
			m:Destroy()
			explode(hit.Position, 2.2)
			shockwave(hit.Position, 0.7, true)
			addShake(1.2)
			return
		end
		pos = pos + step
		m:PivotTo(CFrame.lookAt(pos, pos + v))
		if life > 15 then
			conn:Disconnect()
			m:Destroy()
		end
	end)
end

