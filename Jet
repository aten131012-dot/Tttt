-- ไฟท้าย afterburner (2 เครื่องยนต์)
local function setFire(m, rate, boost)
	if not m then return end
	local exf = m:FindFirstChild("Exhausts")
	if not exf then return end
	boost = boost and true or false

	if m:GetAttribute("Boost") ~= boost then
		m:SetAttribute("Boost", boost)
		local hl = m:FindFirstChild("BoostHL")
		if hl then hl.Enabled = boost end
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") and p:GetAttribute("Accent") then
				p.Color = boost and PURPLE or RED
			end
		end
		for _, ex in ipairs(exf:GetChildren()) do
			local f = ex:FindFirstChild("FireFx")
			local l = ex:FindFirstChildOfClass("PointLight")
			if f then
				f.Color = boost and PURPLE_SEQ or ORANGE_SEQ
				f.Size = boost and BIG_SIZE or NORM_SIZE
				f.Speed = boost and NumberRange.new(40, 55) or NumberRange.new(20, 30)
			end
			if l then l.Color = boost and PURPLE or Color3.fromRGB(255, 150, 60) end
		end
	end

	local len = 0
	if rate > 0 then len = math.clamp(2.5 + rate * 0.055, 0, 18) end
	local flick = 0.88 + math.random() * 0.24

	for _, ex in ipairs(exf:GetChildren()) do
		local f = ex:FindFirstChild("FireFx")
		local s = ex:FindFirstChild("SmokeFx")
		local l = ex:FindFirstChildOfClass("PointLight")
		local fl = ex:FindFirstChild("Flame")
		local core = ex:FindFirstChild("FlameCore")
		if f then f.Rate = rate * 0.5 end
		if s then s.Rate = boost and 0 or rate * 0.18 end
		if l then l.Brightness = (rate > 0) and (boost and 5 or 2) or 0 end
		if fl and core then
			if len > 0 then
				local L = len * flick
				fl.Size = Vector3.new(L, 1.5, 1.5)
				fl.CFrame = ex.CFrame * CFrame.new(0, 0, L / 2) * CFrame.Angles(0, math.rad(90), 0)
				fl.Color = boost and PURPLE or FLAME_ORANGE
				fl.Transparency = 0.35
				local cl = L * 0.6
				core.Size = Vector3.new(cl, 0.7, 0.7)
				core.CFrame = ex.CFrame * CFrame.new(0, 0, cl / 2) * CFrame.Angles(0, math.rad(90), 0)
				core.Color = boost and CORE_PURPLE or CORE_ORANGE
				core.Transparency = 0.1
			else
				fl.Transparency = 1
				core.Transparency = 1
			end
		end
	end
end

local function setWheels(m, out)
	if not m then return end
	local wf = m:FindFirstChild("Wheels")
	if not wf then return end
	for _, p in ipairs(wf:GetChildren()) do
		p.Transparency = out and 0 or 1
	end
end

local function setNoseFx(m, on)
	if not m then return end
	local n = m:FindFirstChild("NoseFx")
	if not n then return end
	local e1 = n:FindFirstChild("NoseFlame")
	local e2 = n:FindFirstChild("NoseSpark")
	local l = n:FindFirstChildOfClass("PointLight")
	if e1 then e1.Rate = on and 80 or 0 end
	if e2 then e2.Rate = on and 45 or 0 end
	if l then l.Brightness = on and 5 or 0 end
	if on then
		local s = 1.3 + 0.5 * math.sin(os.clock() * 16)
		n.Size = Vector3.new(s, s, s)
		n.Transparency = 0.15
	else
		n.Transparency = 1
	end
end

local function setLandFx(m, on)
	if not m then return end
	local lf = m:FindFirstChild("LandLights")
	if not lf then return end
	local pulse = 0.5 + 0.5 * math.sin(os.clock() * 12)
	for _, p in ipairs(lf:GetChildren()) do
		p.Transparency = on and (0.05 + 0.45 * (1 - pulse)) or 1
		local l = p:FindFirstChildOfClass("PointLight")
		if l then l.Brightness = on and (1.5 + 3 * pulse) or 0 end
	end
end

local function landBurst(m)
	if not m then return end
	local wf = m:FindFirstChild("Wheels")
	if not wf then return end
	for _, p in ipairs(wf:GetChildren()) do
		local e = p:FindFirstChild("TouchSpark")
		if e then e:Emit(22) end
	end
end

-- เส้นแสงปลายปีกตอนเลี้ยว
local function setTurnFx(m, on)
	if not m then return end
	for _, name in ipairs({"TipL", "TipR"}) do
		local tip = m:FindFirstChild(name)
		if tip then
			local tr = tip:FindFirstChild("TurnTrail")
			if tr then tr.Enabled = on end
			local sp = tip:FindFirstChild("TurnSpark")
			if sp then sp.Rate = on and 35 or 0 end
		end
	end
end

-- ไอน้ำสีขาวปลายปีก (ตอนเลี้ยวแรง/เร่ง/กลิ้ง)
local function setVapor(m, on)
	if not m then return end
	for _, name in ipairs({"TipL", "TipR"}) do
		local tip = m:FindFirstChild(name)
		local tr = tip and tip:FindFirstChild("Vapor")
		if tr and tr.Enabled ~= on then tr.Enabled = on end
	end
end

-- ควันสีรุ้งปลายปีก (สกิลควันสี)
