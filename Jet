-- getCF() คืน CFrame ปากกระบอก (หรือ nil เพื่อหยุดยิง)
local function fireLaser(getCF, dur)
	local function mkBeam(color, tr)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Transparency = tr
		p.Size = Vector3.new(0.5, 0.5, 1)
		p.Parent = mf
		return p
	end
	local outer = mkBeam(Color3.fromRGB(255, 50, 100), 0.4)
	local core = mkBeam(Color3.new(1, 1, 1), 0.05)

	local tip = Instance.new("Part")
	tip.Shape = Enum.PartType.Ball
	tip.Anchored = true
	tip.CanCollide = false
	tip.CanQuery = false
	tip.CanTouch = false
	tip.CastShadow = false
	tip.Material = Enum.Material.Neon
	tip.Color = Color3.fromRGB(255, 190, 120)
	tip.Transparency = 0.2
	tip.Size = Vector3.new(1, 1, 1)
	tip.Parent = mf
	local tl = Instance.new("PointLight")
	tl.Color = Color3.fromRGB(255, 90, 120)
	tl.Range = 26
	tl.Brightness = 0
	tl.Parent = tip
	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = SPARK_TEX
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 70, 90))
	sparks.Size = NumberSequence.new({NSK(0, 1.0), NSK(1, 0)})
	sparks.Lifetime = NumberRange.new(0.3, 0.6)
	sparks.Speed = NumberRange.new(15, 35)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Rate = 0
	sparks.Parent = tip

	local t0, lastBoom = os.clock(), 0
	local conn
	conn = RS.Heartbeat:Connect(function()
		local cf = getCF()
		local el = os.clock() - t0
		if not cf or el > dur then
			conn:Disconnect()
			outer:Destroy()
			core:Destroy()
			tip:Destroy()
			return
		end
		local charge = math.clamp(el / 0.2, 0, 1)
		local fade = math.clamp((dur - el) / 0.25, 0, 1)
		local w = charge * fade * (0.9 + 0.1 * math.sin(el * 70))

		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = excludeList()
		rp.IgnoreWater = true
		local MAXL = 600
		local hit = workspace:Raycast(cf.Position, cf.LookVector * MAXL, rp)
		local len = math.max(0.5, hit and hit.Distance or MAXL)
		local mid = cf.Position + cf.LookVector * (len / 2)
		local fin = cf.Position + cf.LookVector * len

		local ow = math.max(0.05, 2.2 * w)
		local cw = math.max(0.05, 0.8 * w)
		outer.Size = Vector3.new(ow, ow, len)
		outer.CFrame = CFrame.lookAt(mid, fin)
		core.Size = Vector3.new(cw, cw, len)
		core.CFrame = outer.CFrame
		local ts = math.max(0.1, 4 * w)
		tip.Size = Vector3.new(ts, ts, ts)
		tip.Position = fin
		tl.Brightness = 6 * w
		sparks.Rate = hit and 90 or 0

		if hit and os.clock() - lastBoom > 0.14 then
			lastBoom = os.clock()
			explode(hit.Position, 0.5)
		end
	end)
end

