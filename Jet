-- ===== ระเบิดเรืองแสง (sc = ขนาด) =====
local function explode(pos, sc)
	sc = sc or 1
	local function ball(color, s0, s1, t, tr0)
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Size = Vector3.new(s0 * sc, s0 * sc, s0 * sc)
		p.Transparency = tr0
		p.CFrame = CFrame.new(pos)
		p.Parent = workspace
		TS:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(s1 * sc, s1 * sc, s1 * sc),
			Transparency = 1,
		}):Play()
		Debris:AddItem(p, t + 0.1)
		return p
	end
	local core = ball(Color3.fromRGB(255, 190, 90), 2, 16, 0.35, 0)
	ball(Color3.fromRGB(190, 100, 255), 3, 30, 0.55, 0.3)
	ball(Color3.fromRGB(80, 230, 255), 1, 10, 0.25, 0.1)

	-- วงแหวนกระแทกแนวนอน
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 200, 120)
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Size = Vector3.new(0.4, 4 * sc, 4 * sc)
	ring.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.3
	ring.Parent = workspace
	TS:Create(ring, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, 46 * sc, 46 * sc),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.6)

	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 170, 80)
	l.Range = 35 * math.max(sc, 0.6)
	l.Brightness = 8
	l.Parent = core
	TS:Create(l, TweenInfo.new(0.5), {Brightness = 0}):Play()

	local sp = Instance.new("Part")
