local function styleBtn(b, accent, bar)
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.BackgroundColor3 = INK
	b.BackgroundTransparency = 0.2
	b.TextColor3 = WHITE

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = b

	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = 1.8
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b

	if bar ~= false then
		local f = Instance.new("Frame")
		f.Name = "Bar"
		f.Size = UDim2.new(0, 4, 0.56, 0)
		f.Position = UDim2.new(0, 8, 0.22, 0)
		f.BackgroundColor3 = accent
		f.BorderSizePixel = 0
		f.Parent = b
		Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
	end

	local dark = accent:Lerp(Color3.new(0, 0, 0), 0.6)
	local function isPress(i)
		return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
	end
	b.InputBegan:Connect(function(i)
		if isPress(i) then
			TS:Create(b, TweenInfo.new(0.08), {BackgroundColor3 = dark, BackgroundTransparency = 0.05}):Play()
			TS:Create(stroke, TweenInfo.new(0.08), {Thickness = 3.2}):Play()
		end
	end)
	b.InputEnded:Connect(function(i)
		if isPress(i) then
			TS:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = INK, BackgroundTransparency = 0.2}):Play()
			TS:Create(stroke, TweenInfo.new(0.15), {Thickness = 1.8}):Play()
		end
	end)
	return b
end

