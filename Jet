	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	if not hrp or S.jet then return end
	setUI("none")
	local myJet = J.buildJet()
	S.jet = myJet

	local fwd = hrp.CFrame.LookVector
	local flat = Vector3.new(fwd.X, 0, fwd.Z)
	flat = (flat.Magnitude > 0) and flat.Unit or Vector3.new(0, 0, -1)
	local tpos = hrp.Position + flat * 30
	local gy = groundY(tpos) or (hrp.Position.Y - 3)
	local target = Vector3.new(tpos.X, gy + GROUND_H, tpos.Z)
	local startPos = target + Vector3.new(350, 150, 350)
	local dur, t = 4, 0
	J.setWheels(myJet, false)

	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not myJet.Parent then conn:Disconnect() return end
		t = math.min(t + dt, dur)
		local a = t / dur
		local e = 1 - (1 - a) ^ 2
		local pos = startPos:Lerp(target, e)
		local dir = (target - startPos).Unit
		local look = Vector3.new(dir.X, dir.Y * (1 - e), dir.Z)
		J.setFire(myJet, a < 0.9 and 90 or 12, false)
		J.setWheels(myJet, a > 0.9)
		J.setLandFx(myJet, a > 0.45)
		myJet:PivotTo(CFrame.lookAt(pos, pos + look))
		if t >= dur then
			conn:Disconnect()
			J.setFire(myJet, 0, false)
			myJet:PivotTo(CFrame.lookAt(target, target - flat))
			J.landBurst(myJet)
			setUI("landed")
			task.delay(2, function()
				if myJet.Parent then J.setLandFx(myJet, false) end
			end)
		end
	end)
end)

-- ===== ขึ้นขี่ =====
J.boardBtn.MouseButton1Click:Connect(function()
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not (S.jet and hrp and hum) or S.riding then return end

	S.riding = true
	S.mode = "ground"
	S.wantTakeoff = false
	setUI("riding")
	hum.PlatformStand = true
	hrp.Anchored = true
	hideChar(c)
	J.setWheels(S.jet, true)

	local startCF = S.jet.PrimaryPart.CFrame
	local look = startCF.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local pitch, roll, speed, grace = 0, 0, 0, 0
	local noseT, rollT = 0, 0
	local pos = startCF.Position
	cam.CameraType = Enum.CameraType.Scriptable

	flyConn = RS.RenderStepped:Connect(function(dt)
		local jet = S.jet
		if not (jet and jet.PrimaryPart and hrp.Parent) then cleanup() return end

		local now = os.clock()
		local boosting = S.boosting
		local turn = (inp.left and 1 or 0) - (inp.right and 1 or 0)
		local climb = (inp.up and 1 or 0) - (inp.down and 1 or 0)

		local f = 0
		local md = hum.MoveDirection
		if md.Magnitude > 0 then
			local cl = cam.CFrame.LookVector
			local fl = Vector3.new(cl.X, 0, cl.Z)
			if fl.Magnitude > 0 then f = md:Dot(fl.Unit) end
		end

		if S.wantTakeoff and S.mode == "ground" then
			S.mode = "air"
			grace = 2
			noseT = 3.2
			speed = math.max(speed, 35)
			pitch = math.max(pitch, 0.25)
			J.takeoffBtn.Visible = false
			J.setLandFx(jet, false)
			task.delay(0.8, function()
				if S.jet and S.mode == "air" then J.setWheels(S.jet, false) end
			end)
		end
		S.wantTakeoff = false

		if S.mode == "ground" then
			local throttle = math.clamp(climb + f, -1, 1)
			local maxF = GROUND_MAX * (boosting and 1.8 or 1)
			local tgt = (throttle > 0) and (throttle * maxF) or (throttle * GROUND_REV)
			speed = speed + (tgt - speed) * math.clamp(dt * 1.2, 0, 1)
			local steer = (0.3 + 0.7 * math.clamp(math.abs(speed) / 6, 0, 1)) * ((speed >= 0) and 1 or -1)
			yaw = yaw + turn * 1.5 * dt * steer

			local fwdV = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
			pos = pos + fwdV * speed * dt

			local gC = groundY(pos)
			if gC then
				local desY = gC + GROUND_H
				pos = Vector3.new(pos.X, pos.Y + (desY - pos.Y) * math.clamp(dt * 10, 0, 1), pos.Z)
			end
			local gF, gR = groundY(pos + fwdV * 5), groundY(pos - fwdV * 5)
			local tp = 0
			if gF and gR then tp = math.clamp(math.atan2(gF - gR, 10), -0.6, 0.6) end
			pitch = pitch + (tp - pitch) * math.clamp(dt * 6, 0, 1)
			roll = roll + (0 - roll) * math.clamp(dt * 6, 0, 1)

			rollT = rollT - dt
			J.setFire(jet, 10 + math.abs(speed) * 0.6 + (boosting and 90 or 0), boosting)
			J.setNoseFx(jet, now < S.laserUntil)
			J.setTurnFx(jet, false)
			J.setLandFx(jet, rollT > 0)
		else
			grace = grace - dt
			noseT = noseT - dt
			local tgt = AIR_SPEED * (boosting and 2.5 or 1) + f * 40
			speed = speed + (tgt - speed) * math.clamp(dt * 0.5, 0, 1)
			yaw = yaw + turn * 1.3 * dt
			pitch = pitch + climb * 1.0 * dt
			if climb == 0 then pitch = pitch * (1 - math.clamp(dt * 1.2, 0, 1)) end
			if grace > 0 then pitch = math.max(pitch, 0.2) end
			pitch = math.clamp(pitch, -1.2, 1.2)
			roll = roll + (turn * 0.8 - roll) * math.clamp(dt * 5, 0, 1)

			J.setFire(jet, boosting and 260 or 80, boosting)
			J.setNoseFx(jet, noseT > 0 or now < S.laserUntil)
			J.setTurnFx(jet, math.abs(roll) > 0.25)
		end
		S.speed = speed

		-- กลิ้งตัว (สกิล)
		local spin = 0
		if S.rolling then
			local p = (now - S.rollStart) / 0.9
			if p >= 1 then
				S.rolling = false
			else
				spin = (p * p * (3 - 2 * p)) * math.pi * 2
			end
		end

		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll + spin)

		if S.mode == "air" then
			pos = pos + rot.LookVector * speed * dt
			local gy = groundY(pos)
			local height = gy and (pos.Y - gy) or math.huge
			local descending = rot.LookVector.Y < -0.03
			J.setLandFx(jet, grace <= 0 and descending and height < 40)
			if grace <= 0 and gy and height <= GROUND_H + 0.2 then
				pos = Vector3.new(pos.X, gy + GROUND_H, pos.Z)
				S.mode = "ground"
				S.rolling = false
				rollT = 2.5
				J.setWheels(jet, true)
				J.landBurst(jet)
				J.addShake(0.4)
				J.takeoffBtn.Visible = true
			end
		end

		-- โล่ + ซ่อนตัว + ควันสี + ไอน้ำปลายปีก
		J.setShield(jet, now < S.shieldUntil)
		local wantCloak = now < S.cloakUntil
		if wantCloak ~= S.cloakOn then
			S.cloakOn = wantCloak
			J.setCloak(jet, wantCloak)
		end
		local wantRb = now < S.rainbowUntil
		if wantRb ~= S.rainbowOn then
			S.rainbowOn = wantRb
			J.setRainbow(jet, wantRb)
		end
		J.setVapor(jet, S.mode == "air" and (boosting or S.rolling or math.abs(roll) > 0.35))

		local cf = CFrame.new(pos) * rot
		jet:PivotTo(cf)
		hrp.CFrame = cf * CFrame.new(0, 1.0, -5)
		hrp.AssemblyLinearVelocity = Vector3.zero

		-- กล้อง: ล็อกอยู่หลังเครื่อง
		local aim = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch * 0.8, 0, 0)
		local camPos = (CFrame.new(pos) * aim * CFrame.new(0, 0, CAM_DIST)).Position + Vector3.new(0, CAM_UP, 0)
		local lead = aim.LookVector * 14
		local want = CFrame.lookAt(camPos, pos + Vector3.new(0, 2, 0) + lead) * CFrame.Angles(0, 0, roll * 0.3)
		local base = cam.CFrame:Lerp(want, math.clamp(dt * 12, 0, 1))
		local sh = S.shake
		if sh > 0.01 then
			base = base * CFrame.new((math.random() - 0.5) * sh, (math.random() - 0.5) * sh, 0)
			S.shake = math.max(0, sh - dt * 2.2)
		else
			S.shake = 0
		end
		cam.CFrame = base
		cam.Focus = CFrame.new(pos)
		local wantFov = 70 + (boosting and 16 or 0) + ((S.mode == "air") and math.abs(turn) * 3 or 0)
		cam.FieldOfView = cam.FieldOfView + (wantFov - cam.FieldOfView) * math.clamp(dt * 4, 0, 1)
	end)
end)

