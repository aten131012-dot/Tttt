local function newMissile(cf)
	local m = Instance.new("Model")
	m.Name = "Missile"
	local function part(size, off, color, mat)
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = mat or Enum.Material.Metal
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
