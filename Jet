local function shockwave(pos, sc, skipExplode)
	sc = sc or 1
	local function shell(shape, color, s0, s1, t, cf, tr0)
		local p = Instance.new("Part")
		p.Shape = shape
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = s0
		p.CFrame = cf
		p.Transparency = tr0
		p.Parent = workspace
		TS:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = s1,
			Transparency = 1,
		}):Play()
		Debris:AddItem(p, t + 0.1)
	end
	shell(Enum.PartType.Ball, Color3.fromRGB(90, 255, 220), Vector3.new(4, 4, 4) * sc, Vector3.new(150, 150, 150) * sc, 0.7, CFrame.new(pos), 0.4)
	shell(Enum.PartType.Cylinder, Color3.fromRGB(190, 100, 255), Vector3.new(0.6, 6, 6) * sc, Vector3.new(0.6, 170, 170) * sc, 0.9,
		CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), 0.2)
	if not skipExplode then
		explode(pos, sc)
		addShake(1.0)
	end
end

