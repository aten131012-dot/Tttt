local function bigBlast(pos)
	J.shockwave(pos)
	flash(pos, Color3.fromRGB(255, 160, 60), 6, 60, 0.6)
	burst(pos, Color3.fromRGB(255, 240, 160), Color3.fromRGB(255, 70, 20), 80, 90)
	-- ไฟลุกค้างบนพื้น
	local fp = newPart(V(1, 1, 1), Color3.fromRGB(255, 120, 30))
	fp.Transparency = 1
	fp.CFrame = N(pos)
	local fe = Instance.new("ParticleEmitter")
	fe.Texture = FIRE_TEX
	fe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(200, 40, 10))
	fe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 1)})
	fe.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1)})
	fe.Lifetime = NumberRange.new(0.8, 1.4)
	fe.Speed = NumberRange.new(10, 22)
	fe.SpreadAngle = Vector2.new(25, 25)
	fe.EmissionDirection = Enum.NormalId.Top
	fe.LightEmission = 1
	fe.Rate = 60
	fe.Parent = fp
	local sm = Instance.new("ParticleEmitter")
	sm.Texture = SMOKE_TEX
	sm.Color = ColorSequence.new(Color3.fromRGB(70, 70, 75))
	sm.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 16)})
	sm.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1)})
	sm.Lifetime = NumberRange.new(2, 3)
	sm.Speed = NumberRange.new(8, 16)
	sm.SpreadAngle = Vector2.new(20, 20)
	sm.EmissionDirection = Enum.NormalId.Top
	sm.Rate = 25
	sm.Parent = fp
	task.delay(1.8, function()
		fe.Enabled = false
		sm.Enabled = false
	end)
	Debris:AddItem(fp, 5)
	for i = 1, 4 do
		task.delay(i * 0.12, function()
			J.explode(pos + V(math.random(-14, 14), math.random(0, 8), math.random(-14, 14)))
		end)
	end
end

track(RS.Heartbeat:Connect(function(dt)
	-- แฟลร์
	for i = #flares, 1, -1 do
		local f = flares[i]
		f.life = f.life + dt
		if f.life >= f.max or not f.part.Parent then
			if f.part.Parent then f.part:Destroy() end
			table.remove(flares, i)
		else
			f.vel = f.vel + V(0, -28, 0) * dt
			f.vel = f.vel * (1 - math.clamp(0.7 * dt, 0, 1))
			f.pos = f.pos + f.vel * dt
			f.part.CFrame = N(f.pos)
			local fade = math.clamp((f.max - f.life) / 0.6, 0, 1)
			f.light.Brightness = (2.5 + math.random() * 1.5) * fade
			local s = (1 + math.random() * 0.4) * fade
			f.part.Size = V(s, s, s) * 1.3
		end
	end

	-- ระเบิด
	for i = #bombs, 1, -1 do
		local b = bombs[i]
		b.life = b.life + dt
		b.vel = b.vel + V(0, -60, 0) * dt
		local step = b.vel * dt
		local hit = rc(b.pos, step + step.Unit * 1.5)
		if hit or b.life > 10 then
			local p = hit and hit.Position or b.pos
			b.model:Destroy()
			table.remove(bombs, i)
			bigBlast(p)
			J.kick(8)
		else
			b.pos = b.pos + step
			b.model:PivotTo(CFrame.lookAt(b.pos, b.pos + b.vel.Unit))
		end
	end
end))

