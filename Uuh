-- โฟลเดอร์เก็บเอฟเฟกต์ (กัน raycast ชนกันเอง)
local fx = workspace:FindFirstChild("NEXORA_FX")
if not fx then
	fx = Instance.new("Folder")
	fx.Name = "NEXORA_FX"
	fx.Parent = workspace
end

local function rc(origin, dir)
	local ex = {J.mf, fx}
	if S.jet then table.insert(ex, S.jet) end
	if lp.Character then table.insert(ex, lp.Character) end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = ex
	rp.IgnoreWater = true
	return workspace:Raycast(origin, dir, rp)
end

local function newPart(size, color, mat, shape)
	local p = Instance.new("Part")
	p.Size = size
	p.Color = color
	p.Material = mat or Enum.Material.Neon
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Parent = fx
	return p
end

-- วงแหวนขยายตัว หันหน้าตามทิศ look
local function ring(pos, look, color, s1, t, tr0)
	local p = newPart(V(0.6, 4, 4), color, Enum.Material.Neon, Enum.PartType.Cylinder)
	p.CFrame = CFrame.lookAt(pos, pos + look) * A(0, math.rad(90), 0)
	p.Transparency = tr0 or 0.2
	TS:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = V(0.6, s1, s1), Transparency = 1,
	}):Play()
	Debris:AddItem(p, t + 0.1)
end

local function flash(pos, color, s0, s1, t)
	local p = newPart(V(s0, s0, s0), color, Enum.Material.Neon, Enum.PartType.Ball)
	p.CFrame = N(pos)
	p.Transparency = 0.1
	TS:Create(p, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = V(s1, s1, s1), Transparency = 1,
	}):Play()
	Debris:AddItem(p, t + 0.1)
end

local function burst(pos, c0, c1, count, speed)
	local sp = newPart(V(1, 1, 1), c0)
	sp.Transparency = 1
	sp.CFrame = N(pos)
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SPARK_TEX
	pe.Color = ColorSequence.new(c0, c1)
	pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)})
	pe.Lifetime = NumberRange.new(0.4, 0.8)
	pe.Speed = NumberRange.new(speed * 0.5, speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = V(0, -25, 0)
	pe.LightEmission = 1
	pe.Rate = 0
	pe.Parent = sp
	pe:Emit(count)
	Debris:AddItem(sp, 1.5)
end

