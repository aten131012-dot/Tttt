J.boardBtn.MouseButton1Click:Connect(function()
	local c = lp.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	if not (jet and hrp and hum) then return end

	riding = true
	mode = "ground"
	wantTakeoff = false
	pendingSwap = false
	S.riding, S.mode, S.jet = true, "ground", jet
	updateVehicleUI()
	setUI("riding")
	if vehicle == "car" then
		J.takeoffBtn.Visible = false
		if J.car then J.car.reset() end
	end
	hum.PlatformStand = true
	hrp.Anchored = true
	hideChar(c)
	if vehicle == "jet" then J.setWheels(jet, true) end

	local startCF = jet.PrimaryPart.CFrame
	local look = startCF.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local pitch, roll, speed, grace = 0, 0, 0, 0
	local noseT, rollT = 0, 0
	local pos = startCF.Position
	cam.CameraType = Enum.CameraType.Scriptable

	flyConn = RS.RenderStepped:Connect(function(dt)
		if not (jet and jet.PrimaryPart and hrp.Parent) then cleanup() return end

		-- สลับยานพาหนะกลางทาง
		if pendingSwap then
			pendingSwap = false
			local newKind = (vehicle == "jet") and "car" or "jet"
			local oldModel = jet
			vehicle = newKind
			jet = buildVehicle(newKind)
			oldModel:Destroy()
			S.jet = jet
			cloakOn, rolling, wantTakeoff = false, false, false
			pitch, roll = 0, 0
			local gy = groundY(pos)
			local h = gy and (pos.Y - gy) or 0
			if newKind == "car" then
				mode = "ground"
				speed = math.clamp(speed, -40, 130)
				J.takeoffBtn.Visible = false
				if J.car then J.car.reset() end
			else
				if h > 8 then
					mode, grace, noseT = "air", 1.2, 1.5
					speed = math.max(speed, 70)
					J.takeoffBtn.Visible = false
				else
					mode = "ground"
					speed = math.clamp(speed, -10, GROUND_MAX)
					J.takeoffBtn.Visible = true
				end
				J.setWheels(jet, mode == "ground")
			end
			updateVehicleUI()
			morphFx(pos)
			J.kick(18)
		end

		local turn = (inp.left and 1 or 0) - (inp.right and 1 or 0)
		local climb = (inp.up and 1 or 0) - (inp.down and 1 or 0)

		local f = 0
		local md = hum.MoveDirection
		if md.Magnitude > 0 then
			local cl = cam.CFrame.LookVector
			local fl = Vector3.new(cl.X, 0, cl.Z)
			if fl.Magnitude > 0 then f = md:Dot(fl.Unit) end
		end

		if wantTakeoff and mode == "ground" and vehicle == "jet" then
			mode = "air"
			grace = 2
			noseT = 3.2
			speed = math.max(speed, 35)
			pitch = math.max(pitch, 0.25)
			J.takeoffBtn.Visible = false
			J.setLandFx(jet, false)
			task.delay(0.8, function()
				if jet and mode == "air" and vehicle == "jet" then J.setWheels(jet, false) end
			end)
		end
		wantTakeoff = false

		local dashing = os.clock() < dashUntil

		if vehicle == "car" and J.car then
			-- ===== โหมดรถ =====
			mode = "ground"
			local throttle = math.clamp(climb + f, -1, 1)
			pos, yaw, pitch, roll, speed = J.car.step(dt, {
				pos = pos, yaw = yaw, speed = speed, turn = turn, throttle = throttle,
				boosting = boosting, groundY = groundY, pitch = pitch, roll = roll,
			})
		elseif mode == "ground" then
			local throttle = math.clamp(climb + f, -1, 1)
			local maxF = GROUND_MAX * (boosting and 1.8 or 1)
			local tgt = (throttle > 0) and (throttle * maxF) or (throttle * GROUND_REV)
			speed = speed + (tgt - speed) * math.clamp(dt * 1.2, 0, 1)
			local steer = (0.3 + 0.7 * math.clamp(math.abs(speed) / 6, 0, 1)) * ((speed >= 0) and 1 or -1)
			yaw = yaw + turn * 1.5 * dt * steer

			local fwdV = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
			pos = pos + fwdV * speed * dt

			local gC = groundY(pos)
			if gC then
				local desY = gC + GROUND_H
				pos = Vector3.new(pos.X, pos.Y + (desY - pos.Y) * math.clamp(dt * 10, 0, 1), pos.Z)
			end
			local gF, gR = groundY(pos + fwdV * 5), groundY(pos - fwdV * 5)
			local tp = 0
			if gF and gR then tp = math.clamp(math.atan2(gF - gR, 10), -0.6, 0.6) end
			pitch = pitch + (tp - pitch) * math.clamp(dt * 6, 0, 1)
			roll = roll + (0 - roll) * math.clamp(dt * 6, 0, 1)

			rollT = rollT - dt
			J.setFire(jet, 10 + math.abs(speed) * 0.6 + (boosting and 90 or 0), boosting)
			J.setNoseFx(jet, false)
			J.setTurnFx(jet, false)
			J.setLandFx(jet, rollT > 0)
		else
			grace = grace - dt
			noseT = noseT - dt
			local tgt = AIR_SPEED * (boosting and 2.5 or 1) + f * 40
			local rate = 0.5
			if dashing then tgt = AIR_SPEED * 4; rate = 4 end
			speed = speed + (tgt - speed) * math.clamp(dt * rate, 0, 1)
			yaw = yaw + turn * 1.3 * dt
			pitch = pitch + climb * 1.0 * dt
			if climb == 0 then pitch = pitch * (1 - math.clamp(dt * 1.2, 0, 1)) end
			if grace > 0 then pitch = math.max(pitch, 0.2) end
			pitch = math.clamp(pitch, -1.2, 1.2)
			roll = roll + (turn * 0.8 - roll) * math.clamp(dt * 5, 0, 1)

			J.setFire(jet, (boosting or dashing) and 260 or 80, boosting or dashing)
			J.setNoseFx(jet, noseT > 0)
			J.setTurnFx(jet, math.abs(roll) > 0.25 or dashing)
		end

		-- กลิ้งตัว (สกิลเครื่องบิน)
		local spin = 0
		if rolling then
			local p = (os.clock() - rollStart) / 0.9
			if p >= 1 then
				rolling = false
			else
				spin = (p * p * (3 - 2 * p)) * math.pi * 2
			end
		end

		local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll + spin)

		if mode == "air" and vehicle == "jet" then
			pos = pos + rot.LookVector * speed * dt
			local gy = groundY(pos)
			local height = gy and (pos.Y - gy) or math.huge
			local descending = rot.LookVector.Y < -0.03
			J.setLandFx(jet, grace <= 0 and descending and height < 40)
			if grace <= 0 and gy and height <= GROUND_H + 0.2 then
				pos = Vector3.new(pos.X, gy + GROUND_H, pos.Z)
				mode = "ground"
				rolling = false
				rollT = 2.5
				J.setWheels(jet, true)
				J.landBurst(jet)
				J.takeoffBtn.Visible = true
			end
		end

		-- โล่ + ซ่อนตัว
		local now = os.clock()
		J.setShield(jet, now < shieldUntil)
		local wantCloak = now < cloakUntil
		if wantCloak ~= cloakOn then
			cloakOn = wantCloak
			J.setCloak(jet, cloakOn)
		end

		local cf = CFrame.new(pos) * rot
		jet:PivotTo(cf)
		hrp.CFrame = cf * CFrame.new(0, 1.0, -5)
		hrp.AssemblyLinearVelocity = Vector3.zero

		-- แชร์สถานะให้ไฟล์ 4/5
		S.mode, S.speed, S.boosting, S.jet = mode, speed, boosting, jet

		-- กล้อง: ล็อกอยู่หลังยาน (ไม่หมุนตามการลากหน้าจอ)
		local isCar = (vehicle == "car" and J.car)
		local cv = isCar and J.car.view or JET_VIEW
		local aim = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch * cv.pf, 0, 0)
		local camPos = (CFrame.new(pos) * aim * CFrame.Angles(-cv.pitch, 0, 0) * CFrame.new(0, 0, cv.dist)).Position
			+ Vector3.new(0, cv.up, 0)
		local want = CFrame.lookAt(camPos, pos + Vector3.new(0, cv.lookUp, 0) + aim.LookVector * cv.ahead)
			* CFrame.Angles(0, 0, roll * cv.rollK)
		cam.CFrame = cam.CFrame:Lerp(want, math.clamp(dt * 12, 0, 1))
		cam.Focus = CFrame.new(pos)

		fovKick = fovKick * (1 - math.clamp(dt * 4, 0, 1))
		local wantFov
		if isCar then
			local cdash = now < J.car.st.dashUntil
			wantFov = 68 + math.clamp(math.abs(speed) / 130, 0, 1.4) * 14 + (boosting and 8 or 0) + (cdash and 12 or 0) + fovKick
		else
			wantFov = 70 + (boosting and 16 or 0) + (dashing and 14 or 0) + fovKick
				+ ((mode == "air") and math.abs(turn) * 3 or 0)
		end
		cam.FieldOfView = cam.FieldOfView + (wantFov - cam.FieldOfView) * math.clamp(dt * 4, 0, 1)
	end)
end)

