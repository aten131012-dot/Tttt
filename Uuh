local podIdx = 1
local pods = {Vector3.new(4.5, -0.95, 1.1), Vector3.new(-4.5, -0.95, 1.1)}

-- ยิงจากตำแหน่ง originCF ไปทางที่ originCF หันหน้า (ใช้ร่วมกันทั้งเครื่องบินและรถ)
local function launchMissile(originCF)
	local mm = newMissile(originCF)
	local life = 0
	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		if not mm.Parent then conn:Disconnect() return end
		life = life + dt
		local spd = math.min(320, 140 + life * 500)
		local cf0 = mm.PrimaryPart.CFrame
		local stepLen = spd * dt

		local ex = {mf}
		local fx = workspace:FindFirstChild("NEXORA_FX")
		if fx then table.insert(ex, fx) end
		if jet then table.insert(ex, jet) end
		if lp.Character then table.insert(ex, lp.Character) end
		local rp = RaycastParams.new()
		rp.FilterType = Enum.RaycastFilterType.Exclude
		rp.FilterDescendantsInstances = ex
		rp.IgnoreWater = true

		local hit = workspace:Raycast(cf0.Position, cf0.LookVector * (stepLen + 2), rp)
		if hit then
			conn:Disconnect()
			explode(hit.Position)
			mm:Destroy()
			return
		end
		mm:PivotTo(cf0 + cf0.LookVector * stepLen)
		if life >= 3 then
			conn:Disconnect()
			explode(cf0.Position)
			mm:Destroy()
		end
	end)
end
J.launchMissile = launchMissile

local function fireMissile()
	if not (riding and jet and jet.PrimaryPart) then return end
	podIdx = 3 - podIdx
	launchMissile(jet.PrimaryPart.CFrame * CFrame.new(pods[podIdx]))
end

