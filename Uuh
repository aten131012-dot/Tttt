J.onSkill = function(label)
	if not (S.jet and S.jet.PrimaryPart) then return end
	local cf = S.jet.PrimaryPart.CFrame
	local pos = cf.Position
	if label == "เร่งความเร็ว" then
		ring(pos, cf.LookVector, Color3.fromRGB(200, 120, 255), 80, 0.6)
		ring(pos - cf.LookVector * 6, cf.LookVector, Color3.fromRGB(255, 255, 255), 55, 0.45, 0.4)
		J.kick(14)
	elseif label == "พุ่งทะยาน" then
		ring(pos, cf.LookVector, Color3.fromRGB(120, 255, 170), 100, 0.7)
		ring(pos - cf.LookVector * 8, cf.LookVector, Color3.fromRGB(255, 255, 255), 70, 0.5, 0.35)
		ring(pos - cf.LookVector * 16, cf.LookVector, Color3.fromRGB(120, 255, 170), 50, 0.4, 0.5)
		burst(pos, Color3.fromRGB(230, 255, 240), Color3.fromRGB(80, 255, 150), 40, 70)
		J.kick(26)
	elseif label == "โล่" then
		ring(pos, cf.LookVector, Color3.fromRGB(80, 200, 255), 70, 0.6)
		ring(pos, cf.UpVector, Color3.fromRGB(150, 230, 255), 70, 0.8, 0.4)
	elseif label == "ซ่อนตัว" then
		flash(pos, Color3.fromRGB(150, 160, 255), 6, 40, 0.5)
		burst(pos, Color3.fromRGB(200, 205, 255), Color3.fromRGB(110, 120, 255), 40, 35)
	elseif label == "คลื่นช็อก" then
		J.kick(12)
	elseif label == "กลิ้งตัว" then
		ring(pos, cf.LookVector, Color3.fromRGB(255, 220, 90), 45, 0.5, 0.45)
	end
end

