J.reg(laserBtn, "เลเซอร์", 8, function(d, n)
	if not (S.riding and S.jet and S.jet.PrimaryPart) then return false end
	d.activeUntil = n + 1.4
	local beam = newPart(V(2, 2, 10), Color3.fromRGB(255, 50, 90), Enum.Material.Neon)
	beam.Transparency = 0.25
	local core = newPart(V(0.8, 0.8, 10), Color3.new(1, 1, 1), Enum.Material.Neon)
	local muzzle = newPart(V(4, 4, 4), Color3.fromRGB(255, 120, 150), Enum.Material.Neon, Enum.PartType.Ball)
	muzzle.Transparency = 0.2
	local ml = Instance.new("PointLight")
	ml.Color = Color3.fromRGB(255, 80, 120)
	ml.Range = 28
	ml.Brightness = 6
	ml.Parent = muzzle

	local start, nextImpact, nextBlast = os.clock(), 0, 0
	local conn
	conn = RS.Heartbeat:Connect(function()
		local t = os.clock() - start
		if t > 1.4 or not (S.riding and S.jet and S.jet.PrimaryPart) then
			conn:Disconnect()
			beam:Destroy() core:Destroy() muzzle:Destroy()
			return
		end
		local cf = S.jet.PrimaryPart.CFrame
		local o = (cf * N(0, -0.05, -21)).Position
		local dir = cf.LookVector
		local hit = rc(o, dir * 600)
		local len = hit and (hit.Position - o).Magnitude or 600

		local w = 1
		if t < 0.15 then w = t / 0.15 elseif t > 1.2 then w = (1.4 - t) / 0.2 end
		w = math.clamp(w, 0.05, 1)
		local fl = 0.9 + math.random() * 0.2

		beam.Size = V(2.2 * w * fl, 2.2 * w * fl, len)
		beam.CFrame = CFrame.lookAt(o, o + dir) * N(0, 0, -len / 2)
		core.Size = V(0.8 * w, 0.8 * w, len)
		core.CFrame = beam.CFrame
		local ms = 4 * w * fl
		muzzle.Size = V(ms, ms, ms)
		muzzle.CFrame = N(o)

		if hit then
			if t > nextImpact then
				nextImpact = t + 0.08
				flash(hit.Position, Color3.fromRGB(255, 130, 160), 2, 9, 0.2)
				burst(hit.Position, Color3.fromRGB(255, 230, 240), Color3.fromRGB(255, 60, 100), 10, 40)
			end
			if t > nextBlast then
				nextBlast = t + 0.45
				J.explode(hit.Position)
			end
		end
	end)
end)

