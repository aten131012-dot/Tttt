-- J.reg(...)    = สกิลของเครื่องบิน
-- J.regCar(...) = สกิลของรถ (ปุ่มเดียวกัน แต่เปลี่ยนชื่อ/การทำงาน)
-- fn(def, now) คืน false = ใช้ไม่ได้ (ไม่เสียคูลดาวน์)
-- J.onSkill(label) ถูกเรียกหลังใช้สกิลสำเร็จ (ไฟล์ 4 ใช้ใส่เอฟเฟกต์เสริม)
local btnDef = {}
local function regFor(kind, btn, label, cd, fn)
	local d = btnDef[btn]
	if not d then
		d = {btn = btn, defs = {}}
		btnDef[btn] = d
		table.insert(skillDefs, d)
		btn.MouseButton1Click:Connect(function()
			if not riding then return end
			local def = d.defs[vehicle]
			if not def then return end
			local n = os.clock()
			if n < def.cdUntil then return end
			def.cdUntil = n + def.cd
			local r = def.fn(def, n)
			if r == false then
				def.cdUntil = 0
			elseif J.onSkill then
				pcall(J.onSkill, def.label, vehicle)
			end
		end)
	end
	d.defs[kind] = {btn = btn, label = label, cd = cd, fn = fn, activeUntil = 0, cdUntil = 0}
end
J.reg = function(btn, label, cd, fn) regFor("jet", btn, label, cd, fn) end
J.regCar = function(btn, label, cd, fn) regFor("car", btn, label, cd, fn) end

