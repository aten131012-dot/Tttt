-- ===== หมุนล้อ + เลี้ยวล้อหน้า =====
local function spinWheels(m, d, angle, steer)
	local pc = m.PrimaryPart.CFrame
	local spin = A(angle, 0, 0)
	for _, w in ipairs(d.wheels) do
		local rot = w.front and (A(0, steer, 0) * spin) or spin
		local m2 = pc * w.center * rot * w.center:Inverse()
		for _, e in ipairs(w.parts) do e.p.CFrame = m2 * e.off end
	end
end

-- ===== เอฟเฟกต์ตอนล้อกระแทกพื้น =====
local function landFx(m, impact)
	local d = m and data[m]
	if not d then return end
	for _, w in ipairs(d.wheels) do
		local ts = w.tire:FindFirstChild("TouchSpark")
		if ts then ts:Emit(14) end
		local sm = w.tire:FindFirstChild("TireSmoke")
		if sm then sm:Emit(6) end
	end
	J.kick(math.min(impact * 0.15, 10))
end

local function reset()
	st.vy, st.airborne, st.slip = 0, false, 0
	st.driftUntil, st.dashUntil, st.steer, st.lastTh = 0, 0, 0, 0
end

-- ===== ฟิสิกส์ขับรถ (เรียกทุกเฟรมจากไฟล์ 3) =====
local function step(dt, c)
	local m = S.jet
	local d = m and data[m]
	local now = os.clock()
	local pos, yaw, speed = c.pos, c.yaw, c.speed
	local boost = c.boosting
	local dashing = now < st.dashUntil
	local drifting = (now < st.driftUntil) and not st.airborne
	local th = c.throttle

	-- ความเร็ว
	local maxF = CAR_MAX * (boost and 1.7 or 1)
	if dashing then maxF = CAR_MAX * 2.4 end
	local tgt
	if dashing then tgt = maxF
	elseif th > 0 then tgt = th * maxF
	else tgt = th * CAR_REV end
	local acc = (th ~= 0) and 1.7 or 0.7
	if th < 0 and speed > 5 then acc = 3.2 end -- เบรก
	if boost and th > 0 then acc = 2.6 end
	if dashing then acc = 5 end
	speed = speed + (tgt - speed) * math.clamp(dt * acc, 0, 1)

	-- เลี้ยว (ยิ่งเร็วยิ่งเลี้ยวยาก, ดริฟต์เลี้ยวแรงขึ้น + ท้ายปัด)
	local sp = math.abs(speed)
	local auth = math.clamp(sp / 10, 0, 1) * (1 - math.clamp((sp - 60) / 200, 0, 0.45))
	if st.airborne then auth = auth * 0.3 end
	local dirSign = (speed >= 0) and 1 or -1
	yaw = yaw + c.turn * (drifting and 2.6 or 1.7) * dt * auth * dirSign
	local targetSlip = drifting and (-c.turn * 0.45 * math.clamp(sp / 40, 0, 1)) or 0
	st.slip = st.slip + (targetSlip - st.slip) * math.clamp(dt * 6, 0, 1)
	local travel = yaw + st.slip
	local fwdV = Vector3.new(-math.sin(travel), 0, -math.cos(travel))
	pos = pos + fwdV * speed * dt

	-- แนวตั้ง: ตามพื้น / กระโดด / ตกจากที่สูง
	local gC = c.groundY(pos)
	if gC then
		local desY = gC + CAR_H
		if st.vy ~= 0 or pos.Y > desY + 0.3 then
			st.airborne = true
			st.vy = st.vy - 130 * dt
			pos = Vector3.new(pos.X, pos.Y + st.vy * dt, pos.Z)
			if pos.Y <= desY then
				pos = Vector3.new(pos.X, desY, pos.Z)
				if st.vy < -25 then landFx(m, -st.vy) end
				st.vy = 0
				st.airborne = false
			end
		else
			st.airborne = false
			pos = Vector3.new(pos.X, pos.Y + (desY - pos.Y) * math.clamp(dt * 14, 0, 1), pos.Z)
		end
	else
		st.airborne = true
		st.vy = st.vy - 130 * dt
		pos = Vector3.new(pos.X, pos.Y + st.vy * dt, pos.Z)
	end

	-- ท่าทางตัวรถ
	local faceV = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local tp = 0
	if st.airborne then
		tp = math.clamp(st.vy * 0.012, -0.5, 0.5)
	else
		local gF, gR = c.groundY(pos + faceV * 4.5), c.groundY(pos - faceV * 4.5)
		if gF and gR then tp = math.clamp(math.atan2(gF - gR, 9), -0.6, 0.6) end
	end
	local pitch = c.pitch + (tp - c.pitch) * math.clamp(dt * 8, 0, 1)
	local rtgt = st.airborne and 0 or (-c.turn * (drifting and 0.1 or 0.045) * math.clamp(sp / 70, 0, 1))
	local roll = c.roll + (rtgt - c.roll) * math.clamp(dt * 6, 0, 1)

	-- ล้อ / ควัน / ไฟท่อ
	if m and d then
		st.wheelAngle = (st.wheelAngle - speed * dt / 1.3) % (2 * math.pi)
		st.steer = st.steer + (c.turn * 0.42 - st.steer) * math.clamp(dt * 8, 0, 1)
		spinWheels(m, d, st.wheelAngle, st.steer)

		local smoking = (drifting or (th < 0 and speed > 40)) and sp > 25 and not st.airborne
		for _, w in ipairs(d.wheels) do
			local sm = w.tire:FindFirstChild("TireSmoke")
			local sk = w.tire:FindFirstChild("Skid")
			if sm then sm.Rate = smoking and 70 or 0 end
			if sk then sk.Rate = smoking and 35 or 0 end
		end

		local flameRate = 0
		if boost or dashing then flameRate = 150
		elseif th > 0.7 and speed > 60 then flameRate = 22 end
		J.setFire(m, flameRate, boost or dashing)
		for _, ex in ipairs(d.exf:GetChildren()) do -- ให้เปลวเล็กพอดีท่อรถ
			local fl, core = ex:FindFirstChild("Flame"), ex:FindFirstChild("FlameCore")
			if fl and fl.Transparency < 1 then fl.Size = V(fl.Size.X, 0.9, 0.9) end
			if core and core.Transparency < 1 then core.Size = V(core.Size.X, 0.45, 0.45) end
			if st.lastTh > 0.5 and th <= 0.1 and speed > 50 then -- ท่อแตกตอนปล่อยคันเร่ง
				local f = ex:FindFirstChild("FireFx")
				if f then f:Emit(6) end
			end
		end
	end
	st.lastTh = th

	return pos, yaw, pitch, roll, speed
end

