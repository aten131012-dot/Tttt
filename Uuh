track(RS.RenderStepped:Connect(function(dt)
	local target = 0
	if S.riding and S.vehicle == "car" then
		target = math.clamp((S.speed - 90) / 130, 0, 1)
	elseif S.riding and S.mode == "air" then
		target = math.clamp((S.speed - 110) / 170, 0, 1)
	end
	inten = inten + (target - inten) * math.clamp(dt * 5, 0, 1)
	for _, l in ipairs(lines) do
		if inten < 0.03 then
			l.f.Visible = false
		else
			l.r = l.r + dt * (1.2 + inten * 2.6)
			if l.r > 1 then
				l.r = math.random() * 0.15
				l.a = math.random() * math.pi * 2
			end
			local rad = 0.36 + l.r * 0.64
			l.f.Visible = true
			l.f.Position = UDim2.fromScale(0.5 + math.cos(l.a) * rad * 0.8, 0.5 + math.sin(l.a) * rad * 0.8)
			l.f.Rotation = math.deg(l.a)
			l.f.Size = UDim2.fromOffset(20 + l.r * 140 * inten, 2)
			l.f.BackgroundTransparency = 1 - inten * 0.6 * math.sin(l.r * math.pi)
		end
	end
end))

