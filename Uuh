-- ===== โมเดลเจ็ตขับไล่ =====
local function buildJet()
	local m = Instance.new("Model")
	m.Name = "NEXORA_Jet"
	local V, A, N = Vector3.new, CFrame.Angles, CFrame.new
	local DARK = Color3.fromRGB(45, 50, 62)
	local GREY = Color3.fromRGB(110, 120, 135)
	local LIGHT = Color3.fromRGB(190, 195, 205)
	local BLACK = Color3.fromRGB(15, 16, 20)
	local TINT = Color3.fromRGB(35, 95, 140)

	local function mk(size, cf, color, opts)
		opts = opts or {}
		local p = Instance.new("Part")
		p.Size = size
		p.Color = color
		p.Material = opts.mat or Enum.Material.Metal
		p.Transparency = opts.tr or 0
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		if opts.shape then p.Shape = opts.shape end
		if opts.mesh then
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = opts.mesh
			sm.Scale = Vector3.new(1, 1, 1)
			sm.Parent = p
		end
		if opts.accent then p:SetAttribute("Accent", true) end
		p.CFrame = cf
		p.Parent = m
		return p
	end

	local function cyl(len, dia, cf, color, opts)
		opts = opts or {}
		opts.shape = Enum.PartType.Cylinder
		return mk(V(len, dia, dia), cf * A(0, math.rad(90), 0), color, opts)
	end

	local pivot = mk(V(1, 1, 1), N(0, 0, 0), DARK, {tr = 1})

	-- ลำตัว
	mk(V(2.8, 2.0, 12), N(0, 0, 0.5), DARK)
	mk(V(2.0, 0.7, 11), N(0, 1.15, 1.5), GREY)
	mk(V(2.4, 0.5, 9), N(0, -1.05, 1.5), GREY)
	mk(V(2.3, 1.7, 3), N(0, 0, -7), GREY)
	mk(V(1.7, 1.3, 3), N(0, -0.05, -9.6), DARK)

	-- หัวเครื่อง: กรวยแหลมเรียวลงทีละช่วง + เซ็นเซอร์ปลายจมูก
	local cone = {
		{-11.6, 1.2, 1.35}, {-12.7, 1.2, 1.15}, {-13.8, 1.2, 0.95},
		{-14.9, 1.2, 0.75}, {-15.9, 1.0, 0.55}, {-16.8, 0.9, 0.35}, {-17.5, 0.6, 0.18},
	}
	for i, c in ipairs(cone) do
		cyl(c[2], c[3], N(0, -0.05, c[1]), (i <= 3) and GREY or DARK)
	end
	cyl(0.1, 1.4, N(0, -0.05, -10.95), BLACK) -- ขอบต่อหัว
	cyl(2.6, 0.08, N(0, -0.05, -19.1), LIGHT) -- pitot probe
	cyl(0.2, 0.14, N(0, -0.05, -20.45), RED, {mat = Enum.Material.Neon, accent = true})

	-- แถบไฟข้างลำตัว
	mk(V(0.12, 0.45, 9), N(1.43, 0, -0.5), RED, {mat = Enum.Material.Neon, accent = true})
	mk(V(0.12, 0.45, 9), N(-1.43, 0, -0.5), RED, {mat = Enum.Material.Neon, accent = true})

	-- หลังคากระจกทรงหยดน้ำ (bubble canopy) สีชาเข้ม + โครง
	mk(V(1.95, 0.14, 6.4), N(0, 1.02, -5.3), DARK) -- ขอบล่าง
	local canopy = mk(V(1.7, 1.7, 6.4), N(0, 1.3, -5.3), TINT, {
		mat = Enum.Material.Glass, tr = 0.4, mesh = Enum.MeshType.Sphere,
	})
	canopy.Name = "Canopy"
	canopy.Reflectance = 0.25
	mk(V(1.2, 0.09, 0.14), N(0, 1.62, -7.4), DARK)  -- โครงหน้า
	mk(V(1.3, 0.09, 0.14), N(0, 1.92, -5.3), DARK)  -- โครงกลาง
	mk(V(1.1, 0.09, 0.14), N(0, 1.78, -3.4), DARK)  -- โครงหลัง
	mk(V(0.09, 0.09, 4.2), N(0, 2.12, -5.3), DARK)  -- สันบนหลังคา
	mk(V(1.2, 0.5, 3.2), N(0, 1.65, -1.4), GREY)    -- สันหลังหลังคา
	mk(V(0.9, 0.5, 0.6), N(0, 1.2, -4.6), DARK)     -- ไหล่นักบิน
	mk(V(0.7, 0.7, 0.7), N(0, 1.55, -4.9), Color3.fromRGB(230, 232, 238), {
		shape = Enum.PartType.Ball, mat = Enum.Material.SmoothPlastic,
	}) -- หมวกนักบิน
	mk(V(0.5, 0.25, 0.3), N(0, 1.55, -5.2), BLACK, {mat = Enum.Material.Glass}) -- กระบังหน้า

	-- ช่องรับอากาศ
	for _, s in ipairs({1, -1}) do
		mk(V(1.7, 1.6, 5), N(2.05 * s, -0.35, -3.4), DARK)
		mk(V(1.5, 1.3, 0.15), N(2.05 * s, -0.35, -5.95), BLACK)
	end

	-- ปีก + หาง + ครีบ + มิสไซล์ใต้ปีก
