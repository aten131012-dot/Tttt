		-- รถตกลงมาจากฟ้า หันหน้าเข้าหาผู้เล่น
		local startPos = target + Vector3.new(0, 260, 0)
		local dur, t = 1.8, 0
		local conn
		conn = RS.Heartbeat:Connect(function(dt)
			if not myJet.Parent then conn:Disconnect() return end
			t = math.min(t + dt, dur)
			local a = t / dur
			local pos = startPos:Lerp(target, a * a)
			J.setFire(myJet, a < 0.95 and 70 or 0, false)
			myJet:PivotTo(CFrame.lookAt(pos, pos - flat) * CFrame.Angles(-0.4 * (1 - a), 0, 0))
			if t >= dur then
				conn:Disconnect()
				J.setFire(myJet, 0, false)
				myJet:PivotTo(CFrame.lookAt(target, target - flat))
				if J.car then J.car.landFx(myJet, 70) end
